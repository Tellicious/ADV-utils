# Doxygen configuration for ADV-utils
# Lean config: only non-default keys are set. Public API (headers) + README.
# Run locally:  PROJECT_NUMBER=$(git describe --tags --always) doxygen Doxyfile
# Output:       build/doc/html/index.html

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "ADV-utils"
PROJECT_NUMBER         = $(PROJECT_NUMBER)
PROJECT_BRIEF          = "Collection of useful C utilities (MISRA-compliant)"
OUTPUT_DIRECTORY       = build/doc
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
TAB_SIZE               = 4

#---------------------------------------------------------------------------
# Input  (public headers + README as landing page; src/ and tests/ excluded)
#---------------------------------------------------------------------------
INPUT                  = Readme.md inc
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = Readme.md
# EXAMPLE_PATH           = examples

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES

#---------------------------------------------------------------------------
# Preprocessor: expand both allocation modes so static + dynamic APIs render
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = inc
PREDEFINED             = ADVUTILS_USE_DYNAMIC_ALLOCATION \
                         ADVUTILS_USE_STATIC_ALLOCATION \
                         DOXYGEN

#---------------------------------------------------------------------------
# Warnings — the tree is documented to zero warnings, so gate hard here.
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_SECTIONS  = YES
ALPHABETICAL_INDEX     = YES
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Diagrams (requires graphviz)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
